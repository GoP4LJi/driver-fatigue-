# ==============================================================================
# Driver Fatigue & Distraction Detection System - Environment Configuration
# Copy this file to .env and adjust variables as needed for your local setup.
# ==============================================================================

# Camera Settings
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=30

# Detection & Threshold Defaults
EAR_THRESHOLD=0.25
MAR_THRESHOLD=0.60
HEAD_PITCH_THRESHOLD=15.0
HEAD_YAW_THRESHOLD=20.0
HEAD_ROLL_THRESHOLD=20.0

# Alert Settings
ENABLE_AUDIO_ALERTS=True
ALERT_COOLDOWN_SECONDS=3.0
ALERT_VOLUME=0.8

# Model Paths
MODEL_PATH=models/saved_models/driver_state_classifier.joblib

# Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

